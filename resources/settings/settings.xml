<!-- Settings shown in the simulator's settings editor and, for store installs,
     in Garmin Connect. The same choices are on the watch via getSettingsView(). -->
<settings>
    <setting propertyKey="@Properties.TextColour" title="@Strings.TextColourTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TextBlack</listEntry>
            <listEntry value="1">@Strings.TextNavy</listEntry>
            <listEntry value="2">@Strings.TextPurple</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.AccentColour" title="@Strings.AccentTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.AccentOrange</listEntry>
            <listEntry value="1">@Strings.AccentMagenta</listEntry>
            <listEntry value="2">@Strings.AccentAmber</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.HeartRateLabel" title="@Strings.HeartRateLabelTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.HeartRateRest</listEntry>
            <listEntry value="1">@Strings.HeartRateMax</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.TimeFont" title="@Strings.TimeFontTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TimeFontClassic</listEntry>
            <listEntry value="1">@Strings.TimeFontBold</listEntry>
            <listEntry value="2">@Strings.TimeFontLcd</listEntry>
            <listEntry value="3">@Strings.TimeFontDots</listEntry>
            <listEntry value="4">@Strings.TimeFontHand</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.RubberDuck" title="@Strings.RubberDuckTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.Off</listEntry>
            <listEntry value="1">@Strings.On</listEntry>
        </settingConfig>
    </setting>
</settings>
